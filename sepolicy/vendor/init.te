allow init proc_last_kmsg:file { setattr };

# /sys/kernel/tracing
allow init debugfs_tracing_debug:dir { mounton };

# /mnt/vendor/efs
allow init efs_file:dir { mounton };
allow init sec_efs_file:dir mounton;

allow init spu_file:dir mounton;

allow init same_process_hal_file:file { execute };

allow init servicemanager:binder { call transfer };

allow init system_server:binder call;

# Restored from lineage-22.2 (SM-T735)
allow init vbmeta_block_device:lnk_file relabelto;
dontaudit init { app_data_file privapp_data_file system_app_data_file }:dir getattr;
