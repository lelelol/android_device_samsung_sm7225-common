# This is for randomly generated TEE directories in /efs
allow tee efs_file:dir { search read write open add_name };
allow tee efs_file:file { read write open getattr create };
allow tee sec_efs_file:dir create_dir_perms;
allow tee sec_efs_file:file create_file_perms;

# Restored from lineage-22.2 (SM-T735)
allow tee kmsg_device:chr_file { open write };
allow tee vendor_data_file:dir create_dir_perms;
allow tee vendor_data_file:file create_file_perms;
r_dir_file(hal_gatekeeper_default, vendor_data_file)
set_prop(tee, vendor_qseecomd_prop)

# A17 labels /data/vendor/gatekeeper gatekeeper_vendor_data_file (stock: vendor_gatekeeper_data_file,
# writable by tee). Without it the TZ gatekeeper cannot save its throttling record and every
# lockscreen verify after a reboot fails with -506.
allow tee gatekeeper_vendor_data_file:dir create_dir_perms;
allow tee gatekeeper_vendor_data_file:file create_file_perms;
