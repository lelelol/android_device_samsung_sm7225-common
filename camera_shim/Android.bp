// Shim for the stock Samsung camera blobs (see camera_helper_v1_0_shim.S).
cc_library_shared {
    name: "libcamera_helper_v1_0_shim",
    vendor: true,
    compile_multilib: "64",
    srcs: ["camera_helper_v1_0_shim.S"],
    shared_libs: [
        "camera.device@1.0-impl",
        "camera.device@3.2-impl",
    ],
}
