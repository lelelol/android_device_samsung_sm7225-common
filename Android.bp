soong_namespace {
    imports: [
        // display_headers / libsdmutils for sdmext_stub (libsdmextension)
        "hardware/qcom-caf/sm8250",
    ],
}

install_symlink {
    name: "firmware_wlan_WCNSS_qcom_cfg.ini_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/wlan/WCNSS_qcom_cfg.ini",
    symlink_target: "/vendor/etc/wifi/WCNSS_qcom_cfg.ini",
}